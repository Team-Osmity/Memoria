data_*/
mono_crash.*.json
# C#のコンパイル成果物（今後C#を導入した時のために必須）
bin/
obj/
bld/
*.uid

# ==========================================
# Desktop IDEs & OS Specific Ignores (Recommended)
# ==========================================
